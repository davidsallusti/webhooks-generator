{
  "name": "webhooks-generator",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <27"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5176 --strictPort",
    "dev:api": "node server/index.mjs",
    "dev:vite": "vite --host 0.0.0.0 --port 5176 --strictPort",
    "build": "vite build",
    "lint": "eslint .",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:server": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5176 --strictPort"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "playwright": "^1.45.0"
  }
}
